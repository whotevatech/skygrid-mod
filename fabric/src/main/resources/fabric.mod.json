  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "assets/skygrid/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.skygrid.fabric.SkyGridFabric"],
